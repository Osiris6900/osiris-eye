# Public configuration only. Replace every REPLACE_ value before starting.
# This profile's preflight rejects open admission and plaintext observations.
OSIRIS_E2EE_ENABLED=1
OSIRIS_NODE_KEY=/var/lib/osiris-p2p/identity.key
OSIRIS_TRANSPORT_KEY=/var/lib/osiris-p2p/transport.key
OSIRIS_TRANSPORT_KEY_EPOCH=1
OSIRIS_PEER_KEY_STORE=/var/lib/osiris-p2p/peer-keys.sqlite3
OSIRIS_REPLAY_CACHE=/var/lib/osiris-p2p/replay.cache
OSIRIS_REVOCATION_REGISTRY=/var/lib/osiris-p2p/revocations.json
# Durable peer cache: restart-proof rejoin without fixed bootstrap config.
OSIRIS_PEER_CACHE=/var/lib/osiris-p2p/peer-cache.sqlite3
# Ed25519 authority PUBLIC key, 64 hexadecimal characters. Never paste a private key.
OSIRIS_REVOCATION_AUTHORITY_PUBLIC_KEY=REPLACE_WITH_AUTHORITY_PUBLIC_KEY_HEX
# Comma-separated PeerIds, obtained over an authenticated operator channel.
# Include a configured relay's PeerId as well as application peers.
OSIRIS_TRUSTED_PEERS=REPLACE_WITH_ALLOWED_PEER_IDS
OSIRIS_E2EE_RECIPIENTS=REPLACE_WITH_ALLOWED_RECIPIENT_PEER_IDS
OSIRIS_REVOKED_PEERS=
OSIRIS_MDNS_ENABLED=0
OSIRIS_LISTEN_ADDR=/ip4/0.0.0.0/tcp/4001
OSIRIS_HEALTH_HTTP_ADDR=127.0.0.1:9091
OSIRIS_HEALTH_INTERVAL_SECS=30
OSIRIS_MAX_OBSERVATION_AGE_SECS=300
OSIRIS_BOOTSTRAP_RECONNECT_INTERVAL_SECS=15
# How often the node walks the DHT to discover new peers across the internet.
OSIRIS_DHT_WALK_INTERVAL_SECS=120
OSIRIS_REVOCATION_SYNC_INTERVAL_SECS=30
# How long cached peers stay eligible for restart rejoin (default 7 days).
OSIRIS_PEER_CACHE_MAX_AGE_SECS=604800
# How many cached peers to dial on startup (default 16, 0 disables rejoin dials).
OSIRIS_PEER_CACHE_DIAL_ON_START=16
# Home-router port mapping so a laptop node is publicly reachable (default 1).
OSIRIS_UPNP_ENABLED=1
# Without a configured relay, borrow reservations from connected bootstrap peers.
OSIRIS_AUTO_RELAY=1
# Opt-in: also serve as a relay for other nodes. Conservative built-in limits.
# With enough nodes opted in, the mesh needs no dedicated relay server.
OSIRIS_RELAY_SERVER=0
# Community bootstrap seed file. Defaults to the repo-hosted public seed list.
# Set to "off" to disable, or to another https:// URL you control.
# OSIRIS_BOOTSTRAP_SEED_URL=off
# Use a stable reachable direct bootstrap, or a circuit address through a relay.
OSIRIS_BOOTSTRAP_PEERS=REPLACE_WITH_BOOTSTRAP_MULTIADDR
# Optional: advertise only independently verified reachable direct addresses.
# OSIRIS_EXTERNAL_ADDRS=/ip4/PUBLIC_IP/tcp/4001
# Optional: reserve a circuit on an operator-controlled relay (IP TCP only).
# OSIRIS_RELAY_ADDRESS=/ip4/RELAY_IP/tcp/4001/p2p/RELAY_PEER_ID
# Optional: comma-separated relay list for failover across several relays.
# OSIRIS_RELAY_ADDRESSES=/ip4/RELAY1_IP/tcp/4001/p2p/RELAY1_PEER_ID,/ip4/RELAY2_IP/tcp/4001/p2p/RELAY2_PEER_ID
